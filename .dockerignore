# Empeche les artefacts generes localement (bind mount dev sous Windows) de
# fuiter dans le contexte de build de l'image de production. Sans ce fichier,
# api/bootstrap/cache/*.php genere en mode dev (composer install sans
# --no-dev) survit a la commande `composer install --no-dev --no-scripts` de
# l'etape production (qui ne regenere jamais la decouverte de packages), et
# laisse une reference perimee vers un provider dev-only (ex: laravel/pail)
# absent de vendor/ une fois --no-dev applique -> config:cache echoue avec
# "Class ... not found".
api/vendor
api/node_modules
api/bootstrap/cache/*.php
api/storage/framework/cache/*
api/storage/framework/sessions/*
api/storage/framework/testing/*
api/storage/framework/views/*
api/storage/logs/*

# api/.env N'est PAS exclu : cette app n'a pas d'autre mecanisme pour livrer
# sa config de prod au conteneur (pas de env_file ni de bind mount pour lui
# a l'execution, voir docker-compose.yml/app — seule une poignee de
# variables y sont listees explicitement, DB_CONNECTION n'en fait pas
# partie). L'exclure casse silencieusement le deploiement : le conteneur
# demarre sans aucune config reelle et retombe sur les valeurs par defaut
# de Laravel (ex: DB_CONNECTION=sqlite) au lieu de celles de production.
# Ce fichier ne quitte de toute facon jamais cette machine (deploy.yml ne
# fait jamais de `docker push`), donc le bake-in reste local au poste.

web/node_modules
web/dist

.git
.github
.dockerignore
docker-compose*.yml
