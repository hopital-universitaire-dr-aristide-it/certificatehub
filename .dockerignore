# Empeche les artefacts generes localement (composer install / artisan
# package:discover lances hors Docker, ou dans le conteneur dev via bind
# mount) de polluer le contexte de build et de finir copies dans l'image de
# production. Vu en prod : bootstrap/cache/packages.php genere localement
# avec les dependances dev (ex. laravel/pail) survivait tel quel dans l'image
# (composer install --no-dev --no-scripts, donc jamais regenere), et
# `php artisan config:cache` plantait ensuite avec une classe absente
# (Laravel\Pail\PailServiceProvider) puisque --no-dev l'avait exclue.
api/vendor
api/bootstrap/cache/*.php
api/node_modules
api/storage/framework/cache/*
api/storage/framework/sessions/*
api/storage/framework/views/*
api/storage/logs/*
api/.env
api/.env.*
api/.phpunit.cache
api/.phpunit.result.cache

web/node_modules
web/dist

.git
.gitignore
