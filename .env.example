# ============================================================
# CertificateHub — Hôpital Universitaire Dr. Aristide
# Copier vers .env et remplir les valeurs réelles
# Ce fichier est utilisé à la fois par docker-compose (à la racine)
# et doit être copié dans api/.env pour Laravel (voir README).
# ============================================================

# Application
# NOTE: APP_ENV ici choisit le stage Docker a builder (target: ${APP_ENV:-development}
# dans docker-compose.yml) — valeurs valides : "development" ou "production" UNIQUEMENT
# (ce sont les deux stages du Dockerfile). En dev, mettre APP_ENV=development ci-dessous ;
# la vraie valeur Laravel (local/production) est fixee separement par
# docker-compose.dev.yml / docker-compose.prod.yml.
APP_NAME="CertificateHub"
APP_ENV=production
APP_KEY=                          # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://192.168.1.50
FRONTEND_URL=https://192.168.1.50

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=certhub_db
DB_USERNAME=certhub_user
DB_PASSWORD=                      # Mot de passe fort, aléatoire
DB_EXTERNAL_PORT=5434              # Port exposé sur l'hôte (accès DBA/pgAdmin)

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                   # Mot de passe fort, aléatoire

# Cache / Session / Queue
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Backblaze B2 (sauvegarde PostgreSQL — voir docker-compose.prod.yml)
BACKBLAZE_KEY_ID=
BACKBLAZE_APP_KEY=
BACKBLAZE_BUCKET=certhub-aristide-backups

# Typesense (recherche patients/certificats)
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=                # Clé API Typesense (générer une valeur aléatoire forte)
SCOUT_DRIVER=typesense

# Logs
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Sanctum
SANCTUM_STATEFUL_DOMAINS=192.168.1.50

# Timezone
APP_TIMEZONE=America/Port-au-Prince

# pgAdmin (dev uniquement)
PGADMIN_PASSWORD=admin
